{
  "version": 2,
  "rewrites": [
    {
      "source": "/(api|v1|ws|v1/chat/completions)(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!assets|api|v1|ws).*)",
      "destination": "/index.html"
    }
  ]
}
